{
  "schemaVersion": 1,
  "id": "liquidbounce",
  "version": "${version}",
  "name": "Tsunami",
  "description": "An open-source Minecraft client focused on performance and quality-of-life, forked from CCBlueX/LiquidBounce.",
  "authors": [
    "Tsunami contributors"
  ],
  "contributors": $contributors,
  "contact": {},
  "license": "GNU General Public License v3.0",
  "icon": "resources/liquidbounce/icon_64x64.png",
  "environment": "client",
  "entrypoints": {
    "main": []
  },
  "custom": {},
  "mixins": [
    "liquidbounce.mixins.json"
  ],
  "depends": {
    "minecraft": ["${minecraft_version}"],
    "fabricloader": ">=${min_loader_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  },
  "suggests": {
    "fabric": ">=${fabric_version}",
    "viafabricplus": ">=${viafabricplus_version}"
  },
  "breaks": {
    "viafabricplus": "<${viafabricplus_version}"
  },
  "accessWidener": "liquidbounce.accesswidener"
}
